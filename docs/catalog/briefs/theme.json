{
  "meta": {
    "version": "1.0",
    "description": "Tathastu Keepsakes catalog design tokens for automated generation (PIL/reportlab compatible)",
    "updated": "2026-08-04"
  },
  "colors": {
    "petrol_teal": "#1F717A",
    "violet": "#4B2C78",
    "ink": "#16182B",
    "surface": "#F8FAFC",
    "white": "#FFFFFF",
    "soft_wash": "#EAF8F9"
  },
  "colors_rgb": {
    "petrol_teal": [31, 113, 122],
    "violet": [75, 44, 120],
    "ink": [22, 24, 43],
    "surface": [248, 250, 252],
    "white": [255, 255, 255],
    "soft_wash": [234, 248, 249]
  },
  "typography": {
    "display_title": {
      "font_family": "Helvetica-Bold",
      "font_size_pt": 28,
      "line_height": 1.2,
      "letter_spacing": 0.02,
      "color": "petrol_teal",
      "pil_font": "Helvetica-Bold",
      "reportlab_font": "Helvetica-Bold"
    },
    "body_text": {
      "font_family": "Helvetica",
      "font_size_pt": 10.5,
      "line_height": 1.5,
      "letter_spacing": 0,
      "color": "ink",
      "pil_font": "Helvetica",
      "reportlab_font": "Helvetica"
    },
    "price": {
      "font_family": "Helvetica",
      "font_size_pt": 15,
      "line_height": 1.3,
      "letter_spacing": 0,
      "color": "ink",
      "pil_font": "Helvetica",
      "reportlab_font": "Helvetica",
      "tabular_figures": true
    },
    "category_eyebrow": {
      "font_family": "Helvetica-Bold",
      "font_size_pt": 8.5,
      "line_height": 1.2,
      "letter_spacing": 0.05,
      "color": "violet",
      "text_transform": "uppercase",
      "pil_font": "Helvetica-Bold",
      "reportlab_font": "Helvetica-Bold"
    }
  },
  "page": {
    "format": "A4_landscape",
    "orientation": "landscape",
    "width_mm": 297,
    "height_mm": 210,
    "width_pt": 841.89,
    "height_pt": 595.28,
    "dpi": 300,
    "bleed_mm": 3,
    "outer_margin_mm": 15,
    "safe_zone_inset_mm": 5,
    "baseline_grid_mm": 5
  },
  "layout": {
    "panel_left": {
      "label": "Copy Panel",
      "width_mm": 130,
      "margin_left_mm": 15,
      "margin_right_mm": 10,
      "content_types": ["category_eyebrow", "product_name", "description", "price", "specs"]
    },
    "panel_right": {
      "label": "Photo Panel",
      "width_mm": 130,
      "margin_left_mm": 10,
      "margin_right_mm": 15,
      "content_types": ["product_photo"]
    },
    "center_gutter_mm": 7,
    "column_count": 6,
    "column_width_mm": 42,
    "grid_spacing_mm": 5
  },
  "margins": {
    "top_mm": 15,
    "bottom_mm": 15,
    "left_mm": 15,
    "right_mm": 15,
    "safe_zone_top_mm": 20,
    "safe_zone_bottom_mm": 20,
    "safe_zone_left_mm": 20,
    "safe_zone_right_mm": 20
  },
  "photography": {
    "background_color": "white",
    "background_color_alt": "soft_wash",
    "min_dpi": 300,
    "color_space": "sRGB",
    "preferred_aspect_ratios": ["1:1", "3:4"],
    "vignette_enabled": true,
    "vignette_opacity": 0.15,
    "vignette_feather_px": 80
  },
  "cover": {
    "front": {
      "hero_image_bleed": true,
      "overlay_gradient_color": "petrol_teal",
      "overlay_gradient_opacity": 0.2,
      "title_color": "white",
      "title_font_size_pt": 36,
      "subtitle_font_size_pt": 12
    },
    "back": {
      "background_color": "soft_wash",
      "thumbnail_grid": "2x3",
      "thumbnail_size_mm": 40,
      "qr_code_size_mm": 30,
      "contact_info_font_size_pt": 9
    }
  },
  "price_source": {
    "file": "products-source.json",
    "field": "price",
    "currency_symbol": "₹",
    "currency_format": "INR",
    "decimal_places": 0,
    "warning": "NEVER invent or estimate prices. Always fetch from products-source.json"
  },
  "print": {
    "color_mode": "CMYK",
    "profile": "ISO Coated v2 (ECI)",
    "paper_weight_gsm": 170,
    "finish": "matte",
    "binding": "saddle_stitch"
  }
}
