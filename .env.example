# =============================================================================
# Layerix — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# Supabase
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key

# Service-role key — SERVER-SIDE ONLY. Used by lib/supabase/admin.ts for
# order writes/reads/updates that must bypass RLS (mark-paid, confirmation
# read). migration-002 grants the browser anon role INSERT only, so without
# this key orders stay "pending" and the confirmation page 404s.
# !! NEVER prefix this with NEXT_PUBLIC_ — that would leak it to the browser. !!
# Get it from: Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# Firebase — Phone OTP login (replaces Supabase phone OTP)
# =============================================================================
# PUBLIC client config (the 6 values from Firebase console → Project settings →
# General → Your apps → SDK setup → Config). These are IDENTIFIERS, not secrets;
# Firebase is designed to ship them in client code. Safe as NEXT_PUBLIC_.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# SERVER-SIDE admin credentials — SECRETS. From Firebase console → Project
# settings → Service accounts → Generate new private key (a JSON download).
# !! NEVER prefix these with NEXT_PUBLIC_ and NEVER commit real values. !!
# FIREBASE_PRIVATE_KEY: paste the JSON's private_key value in double quotes,
# keeping the literal \n sequences (admin.ts converts them back to newlines).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Razorpay Payments (Standard Checkout)
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# KEY_ID is safe for the browser (NEXT_PUBLIC_). KEY_SECRET is SERVER-ONLY —
# never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook secret from Razorpay Dashboard → Settings → Webhooks
# (HMAC of the raw body; required for /api/payment/webhook)
RAZORPAY_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── ADMIN ACCESS ─────────────────────────────────────────────────────────────
# Comma-separated allowlist of admin email addresses (case-insensitive). A user
# is granted access to /admin and /api/admin/* only when their session email is
# on this list AND has been verified by the provider (Google OAuth, or a
# confirmed email/password sign-up) — see lib/auth/admin.ts.
# If unset, the code falls back to tathastukeepsakes@gmail.com so a misconfigured
# deploy can't lock the owner out. Prefer setting it explicitly here.
ADMIN_EMAILS=tathastukeepsakes@gmail.com

# Kill-switch: set to 'false' to skip storing uploaded STL/photos (local mock
# only). Unset = files ARE stored in the private `quote-uploads` bucket.
# Production must leave this unset or true, and run migration-011.
QUOTE_STORAGE_ENABLED=

# ── E2E TESTING (local only) ─────────────────────────────────────────────────
# Mock payment: when 'true' AND not a production build, the checkout skips the
# real Razorpay modal and writes a real order straight to Supabase (left
# 'pending', since mock signatures cannot be confirmed). This lets you test the
# full create→confirmation flow without Razorpay keys.
# It is HARD-DISABLED in every Vercel build (NODE_ENV=production), so it can
# never charge-bypass in production. Leave blank/unset for real payments.
# OTP is mocked separately via Supabase "Test OTP" (dashboard) — see
# docs/E2E_TESTING_GUIDE.md. No env var needed for that.
NEXT_PUBLIC_MOCK_PAYMENT=

# Upstash Redis — OTP rate limiting (OPTIONAL but recommended for production)
# Without these, OTP rate limiting falls back to per-instance in-memory
# (works locally; not effective across serverless instances).
# Get these from: https://console.upstash.com → create a Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Google Analytics 4 (GA4)
# =============================================================================
# GA4 Measurement ID (format: G-XXXXXXXXXX). This is a PUBLIC identifier, not a
# secret — GA is designed to expose it in client-side code. Safe as NEXT_PUBLIC_.
# Get it from: Google Analytics → Admin → Data Streams → your web stream.
# OPTIONAL: the code falls back to the built-in Tathastu ID (G-X8RL0R1YNH) when
# this is unset, so analytics keeps working on the production property. Set it
# explicitly to target a different property (e.g. a separate staging stream).
# Analytics only loads on the real production deployment. On Vercel it gates on
# VERCEL_ENV (auto-exposed as NEXT_PUBLIC_VERCEL_ENV) so PREVIEW deploys send NO
# hits; off Vercel it falls back to NODE_ENV=production. Dev/preview/test = no hits.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-X8RL0R1YNH

# Kill-switch: set to 'true' to force-disable analytics even in production
# (incident response / privacy / maintenance). Leave blank to keep GA enabled.
# NOTE: NEXT_PUBLIC_ vars are inlined at build time, so a change here takes
# effect on the next build/redeploy — it is not an instant live toggle.
NEXT_PUBLIC_ANALYTICS_DISABLED=

# =============================================================================
# Google AdSense
# =============================================================================
# Publisher / Client ID (format: ca-pub-XXXXXXXXXXXXXXXX). PUBLIC identifier —
# AdSense is designed to expose it in client-side code. Safe as NEXT_PUBLIC_.
# Get it from: AdSense → Account → Account information → Publisher ID.
# OPTIONAL: the code falls back to the built-in Tathastu ID
# (ca-pub-3744909748780337) when unset. Set explicitly to override.
# Only loads on the real production deployment (same gate as GA4).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-3744909748780337

# Kill-switch: set to 'true' to force-disable AdSense even in production.
# NOTE: NEXT_PUBLIC_ vars are inlined at build time — change takes effect on
# the next build/redeploy.
NEXT_PUBLIC_ADSENSE_DISABLED=
