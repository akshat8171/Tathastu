# =============================================================================
# Layerix — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# Supabase
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-anon-key

# Service-role key — SERVER-SIDE ONLY. Used by lib/supabase/admin.ts for
# order writes/reads/updates that must bypass RLS (mark-paid, confirmation
# read). migration-002 grants the browser anon role INSERT only, so without
# this key orders stay "pending" and the confirmation page 404s.
# !! NEVER prefix this with NEXT_PUBLIC_ — that would leak it to the browser. !!
# Get it from: Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =============================================================================
# Firebase — Phone OTP login (replaces Supabase phone OTP)
# =============================================================================
# PUBLIC client config (the 6 values from Firebase console → Project settings →
# General → Your apps → SDK setup → Config). These are IDENTIFIERS, not secrets;
# Firebase is designed to ship them in client code. Safe as NEXT_PUBLIC_.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# SERVER-SIDE admin credentials — SECRETS. From Firebase console → Project
# settings → Service accounts → Generate new private key (a JSON download).
# !! NEVER prefix these with NEXT_PUBLIC_ and NEVER commit real values. !!
# FIREBASE_PRIVATE_KEY: paste the JSON's private_key value in double quotes,
# keeping the literal \n sequences (admin.ts converts them back to newlines).
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Cashfree Payments (Payment Gateway, API version 2023-08-01)
# Get these from: https://merchant.cashfree.com → Developers → API Keys
# CASHFREE_MODE (server) selects the Cashfree API host: 'sandbox' or 'production'.
# NEXT_PUBLIC_CASHFREE_MODE (client) selects the JS SDK mode — keep the two in sync.
CASHFREE_MODE=sandbox
NEXT_PUBLIC_CASHFREE_MODE=sandbox
# App ID = x-client-id (safe-ish, but we keep it server-side); Secret = x-client-secret (SECRET).
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# Webhook signature secret. Cashfree signs webhooks with your PG secret key by
# default; set this only if your dashboard uses a distinct webhook secret.
# If unset, webhook verification falls back to CASHFREE_SECRET_KEY.
CASHFREE_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── ADMIN ACCESS ─────────────────────────────────────────────────────────────
# Comma-separated allowlist of admin email addresses (case-insensitive). A user
# is granted access to /admin and /api/admin/* only when their session email is
# on this list AND has been verified by the provider (Google OAuth, or a
# confirmed email/password sign-up) — see lib/auth/admin.ts.
# If unset, the code falls back to tathastukeepsakes@gmail.com so a misconfigured
# deploy can't lock the owner out. Prefer setting it explicitly here.
ADMIN_EMAILS=tathastukeepsakes@gmail.com

# ── E2E TESTING (local only) ─────────────────────────────────────────────────
# Mock payment: when 'true' AND not a production build, the checkout skips the
# real Cashfree modal and writes a real order straight to Supabase (left
# 'pending', since Cashfree can't confirm a mock order). This lets you test the
# full create→confirmation flow without Cashfree keys.
# It is HARD-DISABLED in every Vercel build (NODE_ENV=production), so it can
# never charge-bypass in production. Leave blank/unset for real payments.
# OTP is mocked separately via Supabase "Test OTP" (dashboard) — see
# docs/E2E_TESTING_GUIDE.md. No env var needed for that.
NEXT_PUBLIC_MOCK_PAYMENT=

# Upstash Redis — OTP rate limiting (OPTIONAL but recommended for production)
# Without these, OTP rate limiting falls back to per-instance in-memory
# (works locally; not effective across serverless instances).
# Get these from: https://console.upstash.com → create a Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
