# Copy to .env and fill in real values.
# Used by start scripts / optional local helpers.

# Meta / Instagram Graph API
META_VERIFY_TOKEN=tathastu_insta_verify_change_me
META_PAGE_ACCESS_TOKEN=EAAB...your_long_lived_page_token
META_IG_USER_ID=your_instagram_business_account_id
META_APP_SECRET=your_app_secret

# Graph API version
META_GRAPH_VERSION=v21.0

# n8n local
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
# Stable named-tunnel host (preferred). Quick tunnels (trycloudflare) are temporary only.
WEBHOOK_URL=https://n8n.tathastukeepsakes.in
GENERIC_TIMEZONE=Asia/Kolkata

# Reel → DM mapping sheet (CSV). Optional overrides; defaults point at config/*.csv
# REEL_MAP_CSV_PATH=/absolute/path/to/reel-message-map.csv
# REEL_MAP_SETTINGS_PATH=/absolute/path/to/settings.csv
# Google Sheet browser editor (copy into CSV after edits):
# REEL_MAP_SHEET_ID=1YMRtxyWcCj3zol2vgh-6Ht7byDEoS6eoTkT4JyaB_l4
